# Copy to ran/srsran/srsran.env and adjust for the target host.

REMOTE_HOST=chensb@172.27.33.78
REMOTE_FREE5GC_ROOT=/data/chensb-data/data-framework/free5gc

LOCAL_SRSRAN_ROOT=external/srsRAN
REMOTE_SRSRAN_ROOT=/data/chensb-data/data-framework/free5gc/external/srsRAN

SRSRAN_REPO=https://github.com/srsran/srsRAN_Project.git
SRSRAN_BRANCH=main

# Current remote host address used by AMF N2 and, for simple one-host tests, UPF N3.
CORE_HOST_IP=10.0.0.197

# srsRAN/default 5GC identity used by this project.
MCC=208
MNC=93
TAC=1
SST=1
SD=010203
DNN=internet

# ZMQ mode is useful before USRP is available. USRP mode can reuse the same source tree.
SRSRAN_BUILD_TYPE=RelWithDebInfo
SRSRAN_CMAKE_ARGS="-DENABLE_UHD=OFF -DENABLE_ZEROMQ=ON -DENABLE_EXPORT=ON -DENABLE_BACKWARD=OFF -DENABLE_WERROR=OFF"
